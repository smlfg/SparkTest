# Agent 5 Inference Engine Configuration

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_PORT=11434
OLLAMA_DATA_DIR=/var/lib/ollama

# Open WebUI Configuration
WEBUI_PORT=8080
WEBUI_NAME="Agent5 Inference Engine"
WEBUI_AUTH=true
ENABLE_NGINX=false

# NIM Configuration
NIM_BASE_URL=http://localhost:8000
NIM_PORT=8000
NGC_API_KEY=your_nvidia_ngc_api_key_here
NIM_DATA_DIR=/var/lib/nim
NIM_CACHE_DIR=/var/cache/nim

# Model Management API Configuration
API_HOST=0.0.0.0
API_PORT=8888

# Default Models
DEFAULT_OLLAMA_MODELS=llama3.1:70b,mistral:7b
DEFAULT_NIM_MODELS=llama-3.1-405b-instruct,llama-3.1-70b-instruct

# GPU Configuration
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
