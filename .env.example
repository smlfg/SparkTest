# Agent 9: Application Layer - Environment Configuration
# Copy this file to .env and customize for your environment

# ================================================================
# Infrastructure URLs
# ================================================================
AGENT_INFERENCE_URL=http://agent4:8000
AGENT_MULTIMODAL_URL=http://agent8:8888

# ================================================================
# Model Configuration
# ================================================================
EMBEDDING_MODEL=text-embedding-ada-002
LLM_MODEL=gpt-4
NER_MODEL=gpt-4
RELATION_MODEL=gpt-4

# ================================================================
# Service Ports
# ================================================================
COMFYUI_PORT=8188
RAG_WORKBENCH_PORT=3000
CHATBOT_PORT=8080
TXT2KG_PORT=3001
VSS_PORT=8081

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# ================================================================
# Resource Limits
# ================================================================
COMFYUI_MEMORY=16G
RAG_MEMORY=8G
CHATBOT_MEMORY=6G
TXT2KG_MEMORY=6G
VSS_MEMORY=12G

# ================================================================
# GPU Configuration
# ================================================================
GPU_DEVICE_IDS=0,1
CUDA_VISIBLE_DEVICES=0,1

# ================================================================
# Application Settings
# ================================================================

# ComfyUI
COMFYUI_ARGS=--listen 0.0.0.0

# RAG Workbench
RAG_TOP_K=5
RAG_CHUNK_SIZE=512

# Multi-Agent Chatbot
NUM_AGENTS=5
COORDINATION_ENABLED=true
MAX_CONVERSATION_HISTORY=50

# txt2kg
KG_EXPORT_FORMAT=cytoscape
KG_VISUALIZATION_ENABLED=true

# VSS
FRAME_EXTRACTION_FPS=1.0
VIDEO_SUMMARY_LENGTH=3

# ================================================================
# Monitoring & Logging
# ================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# ================================================================
# Security (if enabled)
# ================================================================
# ENABLE_AUTHENTICATION=false
# JWT_SECRET=your-secret-key-here
# ENABLE_TLS=false
# TLS_CERT_PATH=/certs/cert.pem
# TLS_KEY_PATH=/certs/key.pem

# ================================================================
# Database (if persistence is enabled)
# ================================================================
# DATABASE_URL=postgresql://user:pass@localhost:5432/agent9
# REDIS_URL=redis://localhost:6379/0

# ================================================================
# Advanced Configuration
# ================================================================
PYTHONUNBUFFERED=1
PYTHONPATH=/app
WORKERS=4
TIMEOUT=300
