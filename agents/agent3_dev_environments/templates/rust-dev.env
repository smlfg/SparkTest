# Rust Development Environment Template
# Source this file: source rust-dev.env

export PROJECT_NAME="rust-project"

# Rust toolchain
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.rustup}"
export CARGO_HOME="${CARGO_HOME:-$HOME/.cargo}"
export PATH="$CARGO_HOME/bin:$PATH"

# Rust compilation
export RUST_BACKTRACE=1
export RUSTFLAGS="-C link-arg=-fuse-ld=lld"
export CARGO_INCREMENTAL=1
export CARGO_TARGET_DIR="target"

# Cargo configuration
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-8}"
export CARGO_NET_GIT_FETCH_WITH_CLI=true

# Development tools
export RUST_LOG="${RUST_LOG:-info}"
export RUST_LOG_STYLE=always

# Cross-compilation for ARM64
export CARGO_BUILD_TARGET="aarch64-unknown-linux-gnu"

# Performance profiling
export CARGO_PROFILE_RELEASE_DEBUG=true

# Testing
export RUST_TEST_THREADS="${RUST_TEST_THREADS:-8}"

# Clippy (linter) configuration
export CLIPPY_DISABLE_DOCS_LINKS=1

echo "Rust Development Environment activated"
echo "  Rustc: $(rustc --version 2>/dev/null || echo 'not installed')"
echo "  Cargo: $(cargo --version 2>/dev/null || echo 'not installed')"
echo "  Target: $CARGO_BUILD_TARGET"
