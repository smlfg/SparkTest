# Go Development Environment Template
# Source this file: source go-dev.env

export PROJECT_NAME="go-project"

# Go paths
export GOPATH="${GOPATH:-$HOME/go}"
export GOROOT="${GOROOT:-/usr/local/go}"
export PATH="$GOROOT/bin:$GOPATH/bin:$PATH"

# Go module configuration
export GO111MODULE=on
export GOPROXY="https://proxy.golang.org,direct"
export GOSUMDB="sum.golang.org"
export GOPRIVATE=""

# Build configuration
export CGO_ENABLED=1
export GOARCH="${GOARCH:-arm64}"
export GOOS="${GOOS:-linux}"

# Development settings
export GOFLAGS="-mod=readonly"
export GOTMPDIR="/tmp/go-builds"

# Performance
export GOMAXPROCS="${GOMAXPROCS:-8}"

# Debugging
export GODEBUG=""

# Testing
export GOTEST_FLAGS="-v -race -coverprofile=coverage.out"

# Tools
export PATH="$GOPATH/bin:$PATH"

# Color output
export GOTERM=xterm-256color

echo "Go Development Environment activated"
echo "  Go: $(go version 2>/dev/null || echo 'not installed')"
echo "  GOPATH: $GOPATH"
echo "  GOARCH: $GOARCH"
