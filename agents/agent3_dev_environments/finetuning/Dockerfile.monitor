# Dockerfile for Training Monitor API
FROM python:3.11-slim

LABEL maintainer="Agent3 Dev Environments"
LABEL description="Training Progress Monitor for LLaMA Factory"

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi>=0.104.0 \
    uvicorn[standard]>=0.24.0 \
    python-multipart>=0.0.6 \
    websockets>=12.0

# Create directories
RUN mkdir -p /app/api /app/output

# Copy API code
COPY api/ /app/api/

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run API
CMD ["uvicorn", "api.training_monitor:app", "--host", "0.0.0.0", "--port", "8000"]
