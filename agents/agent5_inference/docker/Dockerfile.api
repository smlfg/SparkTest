# Option to use shared base image or standalone
ARG BASE_IMAGE=python:3.11-slim
FROM ${BASE_IMAGE}

LABEL agent="agent5"
LABEL component="model-management-api"
LABEL version="1.0.0"

WORKDIR /app

# Install system dependencies (if not using shared base)
RUN if [ "$BASE_IMAGE" = "python:3.11-slim" ]; then \
    apt-get update && apt-get install -y curl && \
    rm -rf /var/lib/apt/lists/*; \
    fi

# Copy requirements and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared utilities (if not already present)
COPY shared/ /app/shared/

# Copy API code
COPY agents/agent5_inference/api/agent5_model_api.py /app/

# Create directories
RUN mkdir -p /app/data /app/logs /app/config

# Expose API port
EXPOSE 8888

# Health check using shared health check module
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 /app/shared/health_check.py --port 8888 || exit 1

# Run the API
CMD ["python3", "agent5_model_api.py"]
