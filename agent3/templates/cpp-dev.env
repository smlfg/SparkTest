# C/C++ Development Environment Template
# Source this file: source cpp-dev.env

export PROJECT_NAME="cpp-project"

# Compiler configuration
export CC="${CC:-clang}"
export CXX="${CXX:-clang++}"
export CFLAGS="-O2 -march=native -Wall -Wextra"
export CXXFLAGS="-O2 -march=native -Wall -Wextra -std=c++20"
export LDFLAGS="-fuse-ld=lld"

# Build system
export CMAKE_GENERATOR="Ninja"
export CMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE:-Release}"
export CMAKE_EXPORT_COMPILE_COMMANDS=ON
export CMAKE_BUILD_PARALLEL_LEVEL="${CMAKE_BUILD_PARALLEL_LEVEL:-8}"

# Build directories
export BUILD_DIR="build"
export INSTALL_PREFIX="$PWD/install"

# Include and library paths
export CPATH="$INSTALL_PREFIX/include:$CPATH"
export LIBRARY_PATH="$INSTALL_PREFIX/lib:$LIBRARY_PATH"
export LD_LIBRARY_PATH="$INSTALL_PREFIX/lib:$LD_LIBRARY_PATH"

# Package config
export PKG_CONFIG_PATH="$INSTALL_PREFIX/lib/pkgconfig:$PKG_CONFIG_PATH"

# Tools
export MAKEFLAGS="-j8"
export NINJA_STATUS="[%f/%t %p :: %es] "

# Debugging
export ASAN_OPTIONS="detect_leaks=1:symbolize=1:color=always"
export UBSAN_OPTIONS="print_stacktrace=1:color=always"

# Performance profiling
export CPUPROFILE="${CPUPROFILE:-./cpu.prof}"
export HEAPPROFILE="${HEAPPROFILE:-./heap.prof}"

echo "C/C++ Development Environment activated"
echo "  Compiler: $CXX"
echo "  Standard: C++20"
echo "  Build type: $CMAKE_BUILD_TYPE"
