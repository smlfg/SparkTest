# Python Machine Learning Development Environment Template
# Source this file: source python-ml.env

export PROJECT_NAME="ml-project"
export PYTHON_VERSION="3.11"

# Virtual environment
export VENV_DIR=".venv"
export VIRTUAL_ENV="$PWD/$VENV_DIR"
export PATH="$VIRTUAL_ENV/bin:$PATH"

# Python paths
export PYTHONPATH="$PWD/src:$PYTHONPATH"
export PYTHONUNBUFFERED=1

# JAX Configuration
export JAX_PLATFORM_NAME="cpu"
export XLA_FLAGS="--xla_force_host_platform_device_count=8"
export JAX_ENABLE_X64=True
export JAX_CHECK_TRACER_LEAKS=1

# Jupyter Configuration
export JUPYTER_CONFIG_DIR="$HOME/.jupyter"
export JUPYTER_DATA_DIR="$HOME/.local/share/jupyter"
export JUPYTER_PORT=8888

# TensorBoard
export TENSORBOARD_PORT=6006
export TENSORBOARD_LOGDIR="./logs"

# Development tools
export PYTEST_ADDOPTS="--color=yes --verbose"
export MYPY_CACHE_DIR=".mypy_cache"

# GPU/Compute (if available)
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"

# Color output
export FORCE_COLOR=1
export CLICOLOR=1

echo "Python ML Environment activated"
echo "  Python: $PYTHON_VERSION"
echo "  Virtual env: $VENV_DIR"
echo "  Jupyter: http://localhost:$JUPYTER_PORT"
